# Dashboard credentials. Set both before exposing the app to a network.
DASHBOARD_USER=autoace
DASHBOARD_PASS=change-this

# Only needed for gated Hugging Face repos (pyannote). The system runs without it.
HF_TOKEN=

# Keep the model cache inside the repo so Docker can bake it into the image.
HF_HOME=./.hf_cache

# Predictor stack: "all", "none", or a comma-separated subset
# (vad,quality,noise,overlap,roles,emotion). Useful for ablations.
VOICETONE_STACK=all

# Batch parallelism and upload limits.
BATCH_WORKERS=4
MAX_UPLOAD_MB=512
MAX_UNCOMPRESSED_MB=2048
